class Solution {
public:
    int maxRotateFunction(vector<int>& nums) {
        long sum = 0;
        long f = 0;
        int n = nums.size();
        
        for (int i = 0; i < n; ++i) {
            sum += nums[i];
            f += (long)i * nums[i];
        }
        
        long maxF = f;
        
        for (int i = n - 1; i > 0; --i) {
            f = f + sum - (long)n * nums[i];
            maxF = max(maxF, f);
        }
        
        return maxF;
    }
};
